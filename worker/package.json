{
  "name": "gusto-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute gusto --remote --file=schema.sql",
    "db:init:local": "wrangler d1 execute gusto --local --file=schema.sql",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --import ./test/register.mjs test/planner.test.ts && node --experimental-strip-types --import ./test/register.mjs test/epiceries.test.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
