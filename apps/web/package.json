{
  "name": "gusto-app",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "build:web": "expo export --platform web --clear && node scripts/sitemap.mjs",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "deploy": "npx expo export -p web && wrangler deploy",
    "preview": "npx expo export -p web && wrangler dev"
  },
  "dependencies": {
    "@expo-google-fonts/instrument-serif": "^0.4.1",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.0",
    "expo-constants": "~18.0.0",
    "expo-file-system": "~19.0.0",
    "expo-font": "~14.0.0",
    "expo-image": "~3.0.0",
    "expo-linking": "~8.0.0",
    "expo-print": "~15.0.0",
    "expo-router": "~6.0.0",
    "expo-sharing": "~14.0.0",
    "expo-status-bar": "~3.0.0",
    "lucide-react-native": "^1.61.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "~5.9.0",
    "wrangler": "^4.152.0"
  }
}
