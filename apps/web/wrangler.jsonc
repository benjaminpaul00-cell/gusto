// Site web Gusto : Worker Cloudflare qui sert les pages statiques générées par « npm run build:web ».
// Déploiement : npm run build:web && npx wrangler deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gusto",
  "compatibility_date": "2026-10-19",
  "observability": { "enabled": true },
  // Petit script qui redirige www.mongusto.ca et l'ancienne adresse workers.dev vers https://mongusto.ca
  "main": "site-worker.js",
  // Garder l'ancienne adresse active : elle redirige vers mongusto.ca
  "workers_dev": true,
  // L'API (pages de recettes), appelée directement sans passer par Internet
  "services": [{ "binding": "API", "service": "gusto-api" }],
  "routes": [
    { "pattern": "mongusto.ca", "custom_domain": true },
    { "pattern": "www.mongusto.ca", "custom_domain": true }
  ],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    // /guides/prix-unitaire → guides/prix-unitaire.html
    "html_handling": "auto-trailing-slash",
    // Adresse inconnue → 404.html (avec un vrai code 404)
    "not_found_handling": "404-page"
  }
}
